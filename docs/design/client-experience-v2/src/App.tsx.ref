import { useEffect, useState } from 'react'
import { Monitor, Smartphone } from 'lucide-react'
import Intake from './screens/Intake'
import Portal from './screens/Portal'
import Approval from './screens/Approval'
import Admin from './screens/Admin'
import Emails from './screens/Emails'

const VIEWS = [
  { id: 'intake', name: 'Intake form' },
  { id: 'portal', name: 'Client portal' },
  { id: 'approval', name: 'Approval' },
  { id: 'admin', name: 'Admin' },
  { id: 'emails', name: 'Emails' },
] as const
type View = (typeof VIEWS)[number]['id']

const fromHash = (): View => {
  const h = window.location.hash.replace('#', '')
  return (VIEWS.find(v => v.id === h)?.id ?? 'intake') as View
}

export default function App() {
  const [view, setView] = useState<View>(fromHash)
  const [phone, setPhone] = useState(false)

  useEffect(() => {
    const on = () => setView(fromHash())
    window.addEventListener('hashchange', on)
    return () => window.removeEventListener('hashchange', on)
  }, [])

  const go = (v: string) => {
    try { window.location.hash = v } catch { /* sandboxed */ }
    setView(v as View)
    document.querySelector('.device > .frame')?.scrollTo(0, 0)
    window.scrollTo(0, 0)
  }

  const screen =
    view === 'intake' ? <Intake go={go} /> :
    view === 'portal' ? <Portal go={go} /> :
    view === 'approval' ? <Approval /> :
    view === 'admin' ? <Admin /> : <Emails />

  return (
    <>
      <div className="proto">
        <div className="proto-inner">
          <span style={{ font: '500 13px var(--body)', color: '#fff' }}>DDF × Pixel <span style={{ color: '#a39ca0' }}>· Client experience v2</span></span>
          <nav className="row" style={{ gap: 2, flexWrap: 'wrap' }} aria-label="Mockup screens">
            {VIEWS.map(v => <button key={v.id} className="proto-tab" aria-current={view === v.id ? 'page' : undefined} onClick={() => go(v.id)}>{v.name}</button>)}
          </nav>
          <span style={{ marginLeft: 'auto' }} className="row">
            <span className="tiny" style={{ color: '#8e877b' }}>Sample data</span>
            <span className="seg">
              <button aria-pressed={!phone} onClick={() => setPhone(false)} aria-label="Desktop view"><Monitor size={13} /></button>
              <button aria-pressed={phone} onClick={() => setPhone(true)} aria-label="Phone view"><Smartphone size={13} /></button>
            </span>
          </span>
        </div>
      </div>
      {phone ? (
        <div className="stage-bg"><div className="device"><div className="frame">{screen}</div></div></div>
      ) : (
        <div className="frame">{screen}</div>
      )}
    </>
  )
}
