export type Approval = 'approved' | 'waiting' | 'changes' | 'none'
export type ArtKind = 'floor' | 'floor-noir' | 'welcome' | 'menu' | 'wood'

export interface Item {
  name: string
  qty: number
  size: string
  material: string
  approval: Approval
  art: ArtKind
  options?: ArtKind[]
  note: string
  isFloor?: boolean
}

