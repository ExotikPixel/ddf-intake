import { useId } from 'react'

// Fictional proof artwork drawn in SVG (no client files are used in this mockup).

export function FloorArt({ variant = 'ivory' }: { variant?: 'ivory' | 'noir' }) {
  const id = useId().replace(/:/g, '')
  const bg = variant === 'ivory' ? '#fbf8f2' : '#151412'
  const ink = variant === 'ivory' ? '#2a2620' : '#f3ecdf'
  const gold = '#b8955a'
  return (
    <svg viewBox="0 0 400 400" role="img" aria-label={`Dance floor wrap proof, ${variant}`} style={{ display: 'block', width: '100%', height: 'auto' }}>
      <defs>
        <path id={`arc-${id}`} d="M 200 200 m -128 0 a 128 128 0 1 1 256 0 a 128 128 0 1 1 -256 0" />
        <pattern id={`tile-${id}`} width="50" height="50" patternUnits="userSpaceOnUse">
          <rect width="50" height="50" fill={bg} />
          <path d="M0 0H50V50" fill="none" stroke={variant === 'ivory' ? '#efe7d8' : '#22201c'} strokeWidth="1" />
        </pattern>
      </defs>
      <rect width="400" height="400" fill={`url(#tile-${id})`} />
      <rect x="14" y="14" width="372" height="372" fill="none" stroke={gold} strokeWidth="1.5" />
      <rect x="22" y="22" width="356" height="356" fill="none" stroke={gold} strokeWidth=".6" />
      {[[22, 22, 1, 1], [378, 22, -1, 1], [22, 378, 1, -1], [378, 378, -1, -1]].map(([x, y, sx, sy], i) => (
        <g key={i} transform={`translate(${x} ${y}) scale(${sx} ${sy})`} fill="none" stroke={gold} strokeWidth="1">
          <path d="M8 46 C 8 22, 22 8, 46 8" />
          <path d="M8 30 C 12 18, 18 12, 30 8" />
          <circle cx="16" cy="16" r="2.4" fill={gold} />
          <ellipse cx="40" cy="20" rx="8" ry="3" transform="rotate(-28 40 20)" />
          <ellipse cx="20" cy="40" rx="8" ry="3" transform="rotate(-62 20 40)" />
        </g>
      ))}
      <circle cx="200" cy="200" r="150" fill="none" stroke={gold} strokeWidth=".7" />
      <circle cx="200" cy="200" r="110" fill={variant === 'ivory' ? '#fffdf8' : '#1b1916'} stroke={gold} strokeWidth="1.4" />
      <text fontFamily="Montserrat, Arial, sans-serif" fontSize="10.5" letterSpacing="5" fill={gold} fontWeight="600">
        <textPath href={`#arc-${id}`} startOffset="2%">AANYA · ROHAN · TWELVE DECEMBER TWENTY TWENTY-SIX ·</textPath>
      </text>
      <text x="152" y="222" textAnchor="middle" fontFamily="'Playfair Display', Georgia, serif" fontStyle="italic" fontSize="84" fill={ink}>A</text>
      <text x="200" y="214" textAnchor="middle" fontFamily="'Playfair Display', Georgia, serif" fontStyle="italic" fontSize="30" fill={gold}>&amp;</text>
      <text x="250" y="222" textAnchor="middle" fontFamily="'Playfair Display', Georgia, serif" fontStyle="italic" fontSize="84" fill={ink}>R</text>
      <line x1="160" y1="252" x2="240" y2="252" stroke={gold} strokeWidth=".8" />
      <text x="200" y="272" textAnchor="middle" fontFamily="Montserrat, Arial, sans-serif" fontSize="9" letterSpacing="4" fill={ink} fontWeight="600">12 · 12 · 2026</text>
    </svg>
  )
}

export function WelcomeArt() {
  return (
    <svg viewBox="0 0 300 420" role="img" aria-label="Welcome sign proof" style={{ display: 'block', width: '100%', height: 'auto' }}>
      <rect width="300" height="420" fill="#f3ede2" />
      <path d="M30 400 V150 A120 120 0 0 1 270 150 V400 Z" fill="#fffdf9" stroke="#b8955a" strokeWidth="1.2" />
      <path d="M40 392 V152 A110 110 0 0 1 260 152 V392 Z" fill="none" stroke="#b8955a" strokeWidth=".5" />
      {Array.from({ length: 7 }).map((_, i) => (
        <ellipse key={i} cx={58 + i * 8} cy={318 + (i % 2) * 6} rx="10" ry="4" fill={i % 2 ? '#3a5c3f' : '#6f8a68'} transform={`rotate(${-40 + i * 9} ${58 + i * 8} ${318 + (i % 2) * 6})`} opacity=".85" />
      ))}
      {Array.from({ length: 7 }).map((_, i) => (
        <ellipse key={`r${i}`} cx={242 - i * 8} cy={318 + (i % 2) * 6} rx="10" ry="4" fill={i % 2 ? '#3a5c3f' : '#6f8a68'} transform={`rotate(${40 - i * 9} ${242 - i * 8} ${318 + (i % 2) * 6})`} opacity=".85" />
      ))}
      <circle cx="94" cy="326" r="5" fill="#6b1a40" /><circle cx="206" cy="326" r="5" fill="#6b1a40" />
      <text x="150" y="150" textAnchor="middle" fontFamily="'Playfair Display', Georgia, serif" fontStyle="italic" fontSize="46" fill="#2a2620">Welcome</text>
      <text x="150" y="182" textAnchor="middle" fontFamily="Montserrat, Arial, sans-serif" fontSize="8.5" letterSpacing="3.5" fill="#8f7246" fontWeight="600">TO THE WEDDING OF</text>
      <text x="150" y="232" textAnchor="middle" fontFamily="'Playfair Display', Georgia, serif" fontSize="30" fill="#2a2620">Aanya</text>
      <text x="150" y="258" textAnchor="middle" fontFamily="'Playfair Display', Georgia, serif" fontStyle="italic" fontSize="20" fill="#b8955a">&amp;</text>
      <text x="150" y="290" textAnchor="middle" fontFamily="'Playfair Display', Georgia, serif" fontSize="30" fill="#2a2620">Rohan</text>
      <text x="150" y="372" textAnchor="middle" fontFamily="Montserrat, Arial, sans-serif" fontSize="8" letterSpacing="3" fill="#5d5a55" fontWeight="600">DECEMBER 12 · 2026</text>
    </svg>
  )
}

export function MenuArt() {
  const drinks = [['Rose & Cardamom Spritz', 'gin · rose · soda'], ['Mango Chili Margarita', 'tequila · mango · tajín'], ['Midnight Old Fashioned', 'bourbon · saffron · orange']]
  return (
    <svg viewBox="0 0 300 420" role="img" aria-label="Bar menu proof" style={{ display: 'block', width: '100%', height: 'auto' }}>
      <rect width="300" height="420" fill="#141311" />
      <rect x="16" y="16" width="268" height="388" fill="none" stroke="#b8955a" strokeWidth=".8" />
      <text x="150" y="86" textAnchor="middle" fontFamily="Montserrat, Arial, sans-serif" fontSize="8.5" letterSpacing="4" fill="#b8955a" fontWeight="600">THE BAR</text>
      <text x="150" y="128" textAnchor="middle" fontFamily="'Playfair Display', Georgia, serif" fontStyle="italic" fontSize="38" fill="#f3ecdf">Signature Sips</text>
      <line x1="110" y1="150" x2="190" y2="150" stroke="#b8955a" strokeWidth=".8" />
      {drinks.map(([n, d], i) => (
        <g key={n}>
          <text x="150" y={200 + i * 62} textAnchor="middle" fontFamily="'Playfair Display', Georgia, serif" fontSize="17" fill="#f3ecdf">{n}</text>
          <text x="150" y={220 + i * 62} textAnchor="middle" fontFamily="Montserrat, Arial, sans-serif" fontSize="8" letterSpacing="2.5" fill="#b8a98f">{d.toUpperCase()}</text>
        </g>
      ))}
      <text x="150" y="384" textAnchor="middle" fontFamily="'Playfair Display', Georgia, serif" fontStyle="italic" fontSize="14" fill="#b8955a">A &amp; R</text>
    </svg>
  )
}

export function WoodArt() {
  const id = useId().replace(/:/g, '')
  return (
    <svg viewBox="0 0 400 400" role="img" aria-label="CNC walnut table number proof" style={{ display: 'block', width: '100%', height: 'auto' }}>
      <defs>
        <linearGradient id={`w-${id}`} x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stopColor="#7a5236" /><stop offset=".5" stopColor="#5e3d27" /><stop offset="1" stopColor="#47301f" />
        </linearGradient>
        <linearGradient id={`bg-${id}`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stopColor="#efe8e2" /><stop offset="1" stopColor="#e2d8cf" /></linearGradient>
      </defs>
      <rect width="400" height="400" fill={`url(#bg-${id})`} />
      <ellipse cx="200" cy="352" rx="120" ry="12" fill="rgba(60,35,20,.18)" />
      <rect x="110" y="70" width="180" height="270" rx="16" fill={`url(#w-${id})`} />
      {Array.from({ length: 14 }).map((_, i) => (
        <path key={i} d={`M110 ${86 + i * 18} C 160 ${78 + i * 18 + (i % 3) * 6}, 230 ${96 + i * 18 - (i % 2) * 8}, 290 ${84 + i * 18}`} fill="none" stroke="rgba(30,18,10,.18)" strokeWidth="1.2" />
      ))}
      <text x="200" y="232" textAnchor="middle" fontFamily="'Instrument Serif', Georgia, serif" fontStyle="italic" fontSize="132" fill="#e9d8c4" opacity=".92">12</text>
      <text x="200" y="290" textAnchor="middle" fontFamily="Geist, Arial, sans-serif" fontSize="11" letterSpacing="4" fill="#e9d8c4" opacity=".85">TABLE</text>
    </svg>
  )
}

export function ProofArt({ kind }: { kind: 'floor' | 'floor-noir' | 'welcome' | 'menu' | 'wood' }) {
  if (kind === 'wood') return <WoodArt />
  if (kind === 'floor') return <FloorArt variant="ivory" />
  if (kind === 'floor-noir') return <FloorArt variant="noir" />
  if (kind === 'welcome') return <WelcomeArt />
  return <MenuArt />
}
